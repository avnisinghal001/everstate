# ─────────────────────────────────────────────────────────────────────────────
#  Everstate · environment
#  Copy to `.env` and fill in what you need. Every value below is optional for
#  local development: with EVERSTATE_OFFLINE=true nothing talks to Google Cloud.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Runtime ───────────────────────────────────────────────────────────────
# true  = deterministic offline LLM + in-memory storage (no credentials needed)
# false = live Gemini on Vertex AI, BigQuery and Spanner (ignored on Cloud Run)
EVERSTATE_OFFLINE=true
PORT=8080
EVERSTATE_DEFAULT_USER=user:developer
# Optional: folder of local AI-IDE agent sessions to import on the Capture page
# EVERSTATE_SESSION_IMPORT_DIR=~/.gemini/antigravity/brain

# ── 2. Google Cloud ──────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# ── 3. Models (Vertex AI) ────────────────────────────────────────────────────
# Fast model: live chat, recall and extraction
EVERSTATE_CHAT_MODEL=gemini-3.8-flash
# Deep model: Dream Cycle consolidation, evals and retrieval tuning
EVERSTATE_REASONING_MODEL=gemini-4-argon

# ── 4. Storage ───────────────────────────────────────────────────────────────
SPANNER_INSTANCE=everstate-spanner
SPANNER_DATABASE=everstate_memory
BIGQUERY_DATASET=everstate_telemetry
BIGQUERY_EVENTS_TABLE=agent_logs

# ── 5. Services ──────────────────────────────────────────────────────────────
# Leave the agent URLs empty to run both agents inside the console process.
EVERSTATE_CONSOLE_URL=http://localhost:8080
EVERSTATE_INTERVIEW_AGENT_URL=
EVERSTATE_RECALL_AGENT_URL=

# ── 6. Access control ────────────────────────────────────────────────────────
# Comma-separated emails and/or domains. `*` = any verified Google account.
AUTH_ALLOWED_EMAILS=you@example.com,example.com
# Local only: skip sign-in as the first allowed identity (never active on Cloud Run)
AUTH_DEV_BYPASS=true

# Firebase Web SDK (Google sign-in). Find these in Firebase console → Project settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_STORAGE_BUCKET=your-gcp-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Identity-Aware Proxy / authenticating reverse proxy (optional)
AUTH_IAP_ENABLED=false
AUTH_IAP_AUDIENCE=
AUTH_IAP_HEADER=x-goog-iap-jwt-assertion
AUTH_PROXY_URL=

# ── 7. Observability ─────────────────────────────────────────────────────────
EVERSTATE_TELEMETRY_ENABLED=true
OTEL_EXPORT_CLOUD_TRACE=false
# Record prompt/response text in traces (turn off for sensitive data)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# ═════════════════════════════════════════════════════════════════════════════
#  Everstate engine (/api/v2). Pick a profile, then override any single port.
# ═════════════════════════════════════════════════════════════════════════════
# local = in-process (tests, laptops) · redis = Redis serves everything
# gcp   = Spanner + Vertex AI + BigQuery, Memorystore/Redis serving tier
EVERSTATE_PROFILE=local
# Port overrides (empty = profile default). See docs/ADAPTERS.md for every name.
# EVERSTATE_STORE=memory|redis|spanner|firestore
# EVERSTATE_INDEX=memory|redis|spanner|firestore|vertex_vector_search|qdrant|pinecone
# EVERSTATE_EMBEDDER=hashing|ollama|vertex|openai_compatible
# EVERSTATE_LLM=offline|gemini|openai_compatible
# EVERSTATE_CACHE=memory|redis|none
# EVERSTATE_EVENTS=memory|redis|bigquery
# EVERSTATE_SERVING=direct|redis
# EVERSTATE_RESEARCHER=none          # gemini_search is opt-in (billed per request)

# Embeddings (empty model = provider default; dims must match your index)
EVERSTATE_EMBED_MODEL=
EVERSTATE_EMBED_DIMENSIONS=768
# EVERSTATE_EMBED_BASE_URL=http://localhost:11434   # ollama

# Redis / Memorystore (Valkey or Redis Cluster)
EVERSTATE_REDIS_URL=redis://localhost:6379/0
EVERSTATE_REDIS_CLUSTER=false
EVERSTATE_REDIS_VECTOR_BACKEND=auto                # auto|query_engine|vectorset

# Google Cloud specifics (project/region/spanner/bigquery reuse the values above)
EVERSTATE_GOOGLE_SPANNER_SEARCH=ann                # ann needs Spanner Enterprise; exact works anywhere
EVERSTATE_GOOGLE_SPANNER_TABLE=EverstateMemories

# Managed vector databases
# EVERSTATE_QDRANT_URL=https://xyz.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# EVERSTATE_PINECONE_HOST=https://everstate-xxxx.svc.region.pinecone.io
# PINECONE_API_KEY=

# Governance: emails allowed to promote shared (org/team/agent) memories
EVERSTATE_ADMINS=
